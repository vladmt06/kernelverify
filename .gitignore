.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
bench/.cache/
# Detached-run artifacts. Since I2 the runner writes one pair per harness
# (detached-<stem>.log, detached_status-<stem>.json), so the patterns are
# globs: the two bare names below predate that and matched nothing after it,
# leaving live run artifacts untracked where a careless add would sweep them in.
bench/.baselines/detached*.log
bench/.baselines/detached_status*.json

# Spartan AI config (contains API keys)
.spartan/ai.env
bench/.models/

# Local-only bench inputs, same dot-dir convention as .cache/ and .models/:
# large, machine-local, and nothing in the repo reads them.
bench/.corpus/

# Rendered planning pages from the lavish CLI: session artefacts, not source.
.lavish/
