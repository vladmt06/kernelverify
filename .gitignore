.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
bench/.cache/
# Detached-run artifacts. Since I2 the runner writes one pair per harness
# (detached-<stem>.log, detached_status-<stem>.json), so the patterns are
# globs: the two bare names below predate that and matched nothing after it,
# leaving live run artifacts untracked where a careless add would sweep them in.
bench/.baselines/detached*.log
bench/.baselines/detached_status*.json

# Spartan AI config (contains API keys)
.spartan/ai.env
bench/.models/

# Local-only bench inputs, same dot-dir convention as .cache/ and .models/:
# large, machine-local, and nothing in the repo reads them.
bench/.corpus/

# Rendered planning pages from the lavish CLI: session artefacts, not source.
.lavish/

# The held-out draw's secret salt (sprint 1 pre-registration, section 7). Its
# sha256 is committed in the pre-registration; the salt itself stays off the
# repo so it can never reach a generator's context, and is published in the
# closing record.
bench/.heldout_salt

# The compiler loop's candidate stores: session evidence, local-only by the
# same dot-dir convention as .cache/ and .models/. What a session KEEPS is
# committed through the keep stage (kept bodies, certificates, recordings),
# never by sweeping a whole store in.
bench/.candidates/

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
